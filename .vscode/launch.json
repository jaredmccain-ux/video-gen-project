{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Full pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_full_pipeline.py",
      "args": [],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.vscode/debug.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "CUDA_VISIBLE_DEVICES": "0"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Full pipeline (first 2 shots only)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_full_pipeline.py",
      "args": ["--max-shots", "2"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.vscode/debug.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "CUDA_VISIBLE_DEVICES": "0"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
