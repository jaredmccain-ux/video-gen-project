      "speaker_id": "C01",
      "text": "嗯？",
      "start_s": 4.59,
      "end_s": 5.19,
      "planned_start_s": 112.39,
      "planned_end_s": 119.49,
      "timing_source": "asr_sensevoice_vad",
      "film_start_s": 116.98,
      "film_end_s": 117.58,
      "asr_match_score": 0.595
    },
    {
      "shot_id": "S016",
      "speaker_id": "C02",
      "text": "下一场，还一起。",
